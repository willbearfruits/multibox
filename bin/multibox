#!/bin/bash
# multibox — status and control CLI for a multibox fleet.
#
#   multibox status [--json]   peer health, clipsync state, extend-display state
#   multibox setup             GUI: arrange seats, set options, apply
#   multibox apply [--from-drop]  regenerate this machine's configs from
#                              machines.json (--from-drop: first pull the fleet
#                              file a peer's setup window saved to ~/Drop)
#   multibox send <machine> <files...>  send files to a machine's ~/Drop/incoming
#   multibox send-window <side>  desktop only: move the focused window onto the
#                              extra-monitor output of that side (needs extend)
#   multibox pause|resume      pause/resume clipboard sync ONLY (file drops,
#                              ~/Drop and extend-display keep working)
#   multibox doctor            health check: config, services, pairing, peers
#   multibox drop              open the Dropzone window
#   multibox extend <args>     desktop only: passthrough to extend-display
#                              (start <side> uses the resolution from options)
#   multibox pair              apply peers' pairing files (lan-mouse + syncthing)
#   multibox pairing-info      write + print this machine's pairing file
#
# Machine list lives in ~/.config/multibox/machines.json (see install.sh):
#   {"machines": [{"name": "...", "ip": "100.x.y.z", "role": "desktop|left|right"}],
#    "options": {"extend": {"left": "1920x1080@60", "right": "1920x1080@60"}}}
set -euo pipefail

CONFIG="$HOME/.config/multibox/machines.json"
FLEET_DROP="$HOME/Drop/multibox-fleet.json"
PAIR_DIR="$HOME/Drop/multibox-pairing"
LM_CONFIG="$HOME/.config/lan-mouse/config.toml"
CLIPSYNC_PORT=46264
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$UID}"
# clipsync honors this flag: paused = no clipboard push/receive, while the
# /file and /monitor endpoints stay up (stopping the service would kill those)
PAUSE_FLAG="$RUNTIME/clipsync.paused"

die() { echo "multibox: $*" >&2; exit 1; }

cmd="${1:-status}"

if [ "$cmd" = apply ] && [ "${2:-}" = --from-drop ]; then
  [ -f "$FLEET_DROP" ] || die "no fleet file at $FLEET_DROP"
  mkdir -p "$(dirname "$CONFIG")"
  cp "$FLEET_DROP" "$CONFIG"
  echo "pulled fleet description from ~/Drop"
fi

[ -f "$CONFIG" ] || die "no $CONFIG — run install.sh first"

my_ip=$(tailscale ip -4 2>/dev/null) || die "tailscale is not running"
self_json=$(jq -e --arg ip "$my_ip" '.machines[] | select(.ip == $ip)' "$CONFIG") \
  || die "own tailscale IP $my_ip not in $CONFIG"
my_name=$(jq -r .name <<<"$self_json")
my_role=$(jq -r .role <<<"$self_json")

probe() {
  # /ping proves the daemon answers; fall back to a TCP connect for peers
  # still running an older clipsync
  curl -sf --max-time 1 "http://$1:$CLIPSYNC_PORT/ping" >/dev/null 2>&1 \
    || timeout 1 bash -c "exec 3<>/dev/tcp/$1/$CLIPSYNC_PORT" 2>/dev/null
}

resolve_ip() {  # name or ip -> ip
  jq -r --arg q "$1" \
    '.machines[] | select(.name == $q or .ip == $q) | .ip' "$CONFIG" | head -1
}

send() {
  local notify=0
  [ "${1:-}" = --notify ] && { notify=1; shift; }
  local target="$1"; shift
  [ $# -ge 1 ] || die "usage: multibox send <machine> <files...>"
  local ip; ip=$(resolve_ip "$target")
  [ -n "$ip" ] || die "unknown machine '$target'"
  local f rc=0
  for f in "$@"; do
    [ -f "$f" ] || { echo "skip $f: not a file"; rc=1; continue; }
    if curl -sf -X POST -H "X-Filename: $(basename "$f")" \
        --data-binary "@$f" --max-time 600 \
        "http://$ip:$CLIPSYNC_PORT/file" >/dev/null; then
      echo "sent $(basename "$f") -> $target"
    else
      echo "FAILED $(basename "$f") -> $target"; rc=1
    fi
  done
  if [ "$notify" = 1 ]; then
    if [ "$rc" = 0 ]; then
      notify-send -a Multibox "Sent to $target" "$# file(s) → ~/Drop/incoming" 2>/dev/null || true
    else
      notify-send -u critical -a Multibox "Send to $target failed" "check: multibox status" 2>/dev/null || true
    fi
  fi
  return $rc
}

send_window() {
  [ "$my_role" = desktop ] || die "send-window is desktop-only"
  local side="${1:-}"
  [ "$side" = left ] || [ "$side" = right ] || die "usage: multibox send-window left|right"
  local sd="$RUNTIME/extend-display"
  [ -f "$sd/$side" ] || die "extend-display is not active on '$side' — run: multibox extend start $side"
  local output; output=$(head -1 "$sd/$side")
  hyprctl dispatch movewindow "mon:$output" >/dev/null \
    && echo "focused window moved to the $side laptop screen ($output)"
}

status() {
  local json="${1:-}"
  local clipsync=false extend_left=false extend_right=false
  systemctl --user is-active --quiet clipsync 2>/dev/null \
    && [ ! -e "$PAUSE_FLAG" ] && clipsync=true
  if [ "$my_role" = desktop ]; then
    [ -f "$RUNTIME/extend-display/left" ] && extend_left=true
    [ -f "$RUNTIME/extend-display/right" ] && extend_right=true
  fi
  # probe peers in parallel: the bar widget polls this every few seconds, and
  # sequential probes would stack ~2s of timeout per offline machine
  local rows row name ip role tmpd
  mapfile -t rows < <(jq -r --arg ip "$my_ip" \
      '.machines[] | select(.ip != $ip) | [.name, .ip, .role] | @tsv' "$CONFIG")
  tmpd=$(mktemp -d)
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r name ip role <<<"$row"
    { probe "$ip" && touch "$tmpd/$ip"; } &
  done
  wait
  local peers="[]" up
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r name ip role <<<"$row"
    up=false
    [ -e "$tmpd/$ip" ] && up=true
    peers=$(jq --arg n "$name" --arg i "$ip" --arg r "$role" --argjson u "$up" \
      '. + [{name: $n, ip: $i, role: $r, up: $u}]' <<<"$peers")
  done
  rm -rf "$tmpd"
  if [ "$json" = "--json" ]; then
    jq -n --arg self "$my_name" --arg role "$my_role" \
      --argjson clipsync "$clipsync" --argjson peers "$peers" \
      --argjson el "$extend_left" --argjson er "$extend_right" \
      '{self: $self, role: $role, clipsync: $clipsync, peers: $peers,
        extend: {left: $el, right: $er}}'
  else
    echo "$my_name ($my_role) — clipsync: $clipsync"
    jq -r '.[] | "  \(.name) [\(.role)] \(.ip): \(if .up then "online" else "OFFLINE" end)"' <<<"$peers"
    [ "$my_role" = desktop ] && echo "  extend-display: left=$extend_left right=$extend_right"
    return 0
  fi
}

# Write the lan-mouse config. A side that extend-display currently owns is
# generated with activate_on_startup = false, so the pause survives ANY
# lan-mouse restart (apply, crash, relogin) — the config, not a live CLI
# toggle, is the source of truth for which edges switch input.
gen_lm_config() {
  mkdir -p ~/.config/lan-mouse
  local auth
  auth=$(awk '/^\[authorized_fingerprints\]/{f=1;next} /^\[/{f=0} f&&NF' \
    "$LM_CONFIG" 2>/dev/null || true)
  {
    echo "# generated by 'multibox apply' — edit machines.json + re-apply instead"
    echo 'port = 4242'
    echo 'release_bind = ["KeyLeftCtrl", "KeyLeftShift", "KeyLeftAlt", "KeyRightCtrl"]'
    if [ "$my_role" = desktop ]; then
      local name ip role act
      while IFS=$'\t' read -r name ip role; do
        act=true
        [ -f "$RUNTIME/extend-display/$role" ] && act=false
        printf '\n[[clients]]\nposition = "%s"\nhostname = "%s"\nips = ["%s"]\nactivate_on_startup = %s\n' \
          "$role" "$name" "$ip" "$act"
      done < <(jq -r --arg ip "$my_ip" \
        '.machines[] | select(.ip != $ip) | [.name, .ip, .role] | @tsv' "$CONFIG")
    else
      local opp; opp=$([ "$my_role" = left ] && echo right || echo left)
      jq -r --arg opp "$opp" '.machines[] | select(.role == "desktop") |
        "\n[[clients]]\nposition = \"\($opp)\"\nhostname = \"\(.name)\"\nips = [\"\(.ip)\"]\nactivate_on_startup = true"' "$CONFIG"
    fi
    echo
    echo '[authorized_fingerprints]'
    [ -n "$auth" ] && echo "$auth"
  } > "$LM_CONFIG"
}

# Regenerate every config this machine's role derives from machines.json,
# then restart the services that read them. Idempotent; keeps authorized
# lan-mouse fingerprints across regenerations.
apply() {
  echo "--- clipsync config"
  mkdir -p ~/.config/clipsync
  jq --arg ip "$my_ip" '{
    listen_ip: $ip,
    peers: [.machines[] | select(.ip != $ip) | .ip],
    names: [.machines[] | {(.ip): .name}] | add
  }' "$CONFIG" > ~/.config/clipsync/config.json

  echo "--- lan-mouse config"
  gen_lm_config

  if [ "$my_role" != desktop ]; then
    echo "--- desktop-monitor viewer"
    local vnc_port desktop_ip h264
    vnc_port=$([ "$my_role" = left ] && echo 5901 || echo 5902)
    desktop_ip=$(jq -r '.machines[] | select(.role == "desktop") | .ip' "$CONFIG")
    h264=$(jq -r '.options.extend.h264 // false' "$CONFIG")
    mkdir -p ~/.local/bin
    if [ "$h264" = true ] && [ -x ~/.local/bin/wlvncc ]; then
      # wlvncc negotiates open-h264 with wayvnc: the desktop GPU encodes
      # video, this iGPU hardware-decodes it — far smoother than VNC tiles.
      # No fullscreen flag exists, so the script fullscreens the window.
      cat > ~/.local/bin/desktop-monitor <<VEOF
#!/bin/bash
export LD_LIBRARY_PATH="\$HOME/.local/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
"\$HOME/.local/bin/wlvncc" -a desktop-monitor -d -e open-h264,tight $desktop_ip $vnc_port &
pid=\$!
sleep 1.5
hyprctl dispatch focuswindow "class:desktop-monitor" >/dev/null 2>&1
hyprctl dispatch fullscreen 0 >/dev/null 2>&1
wait \$pid
VEOF
    else
      [ "$h264" = true ] && echo "note: h264 enabled but ~/.local/bin/wlvncc missing — using TigerVNC"
      # Tight encoding at low compression: on a LAN the bottleneck is encode
      # latency, not bandwidth — stops TigerVNC auto-negotiating itself into
      # laggier settings.
      printf '#!/bin/bash\nexec vncviewer -FullScreen -AutoSelect=0 -PreferredEncoding=Tight -CompressLevel=1 -QualityLevel=9 %s:%s\n' \
        "$desktop_ip" "$vnc_port" > ~/.local/bin/desktop-monitor
    fi
    chmod +x ~/.local/bin/desktop-monitor
  fi

  echo "--- restarting services"
  systemctl --user try-restart clipsync.service lan-mouse.service 2>/dev/null || true

  # the restart re-activates every lan-mouse client (activate_on_startup) —
  # re-pause the sides extend-display currently owns, or the same edge gets
  # two owners (input switching AND a headless output)
  if [ "$my_role" = desktop ]; then
    local side id
    for side in left right; do
      [ -f "$RUNTIME/extend-display/$side" ] || continue
      sleep 1
      id=$(lan-mouse cli list 2>/dev/null \
        | awk -v side="($side)" '$0 ~ side {sub(/^id /,""); sub(/:.*/,""); print; exit}')
      [ -n "$id" ] && lan-mouse cli deactivate "$id" >/dev/null 2>&1 || true
      echo "extend '$side' is active — its lan-mouse client stays paused"
    done
  fi
  echo "applied on $my_name ($my_role)"
}

pairing_info() {
  local pem="$HOME/.config/lan-mouse/lan-mouse.pem"
  for _ in $(seq 1 30); do [ -f "$pem" ] && break; sleep 1; done
  [ -f "$pem" ] || die "no lan-mouse certificate at $pem (is lan-mouse installed?)"
  local fp sid
  fp=$(openssl x509 -in "$pem" -noout -fingerprint -sha256 | sed 's/.*=//;s/://g' | tr 'A-F' 'a-f')
  sid=$(syncthing cli show system 2>/dev/null | jq -r .myID) || sid=""
  mkdir -p "$PAIR_DIR"
  jq -n --arg n "$my_name" --arg i "$my_ip" --arg f "$fp" --arg s "$sid" \
    '{name: $n, ip: $i, lanmouse_fp: $f, syncthing_id: $s}' > "$PAIR_DIR/$my_name.json"
  cat "$PAIR_DIR/$my_name.json"
  # best-effort: hand it to peers directly over the tailnet (they collect it
  # with `multibox pair`); useless before syncthing pairs, harmless after
  jq -r --arg ip "$my_ip" '.machines[] | select(.ip != $ip) | .ip' "$CONFIG" |
  while read -r peer; do
    tailscale file cp "$PAIR_DIR/$my_name.json" "$peer:" 2>/dev/null \
      && echo "sent pairing file to $peer" || true
  done
}

pair() {
  mkdir -p "$PAIR_DIR"
  # collect pairing files peers may have sent via taildrop (needs root or
  # tailscale operator; quietly skip if neither)
  sudo -n tailscale file get "$PAIR_DIR" 2>/dev/null \
    || tailscale file get "$PAIR_DIR" 2>/dev/null || true
  local changed=0 f name fp sid
  for f in "$PAIR_DIR"/*.json; do
    [ -e "$f" ] || { echo "no pairing files in $PAIR_DIR yet"; return 0; }
    name=$(jq -r .name "$f"); fp=$(jq -r .lanmouse_fp "$f"); sid=$(jq -r .syncthing_id "$f")
    [ "$name" = "$my_name" ] && continue
    jq -e --arg n "$name" '.machines[] | select(.name == $n)' "$CONFIG" >/dev/null \
      || { echo "skipping $f: '$name' is not in $CONFIG"; continue; }
    # these strings get spliced into the lan-mouse config / syncthing CLI —
    # accept only the exact shapes a healthy pairing file can contain
    [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "skipping $f: unsafe machine name"; continue; }
    [[ $fp =~ ^[0-9a-f]{64}$ ]] || fp=""
    [[ $sid =~ ^[A-Z0-9-]+$ ]] || sid=""
    if [ -n "$fp" ] && [ -f "$LM_CONFIG" ] && ! grep -q "$fp" "$LM_CONFIG"; then
      grep -q '^\[authorized_fingerprints\]' "$LM_CONFIG" \
        || printf '\n[authorized_fingerprints]\n' >> "$LM_CONFIG"
      sed -i "/^\[authorized_fingerprints\]/a \"$fp\" = \"$name\"" "$LM_CONFIG"
      echo "lan-mouse: authorized $name"
      changed=1
    fi
    if [ -n "$sid" ]; then
      syncthing cli config devices add --device-id "$sid" --name "$name" 2>/dev/null \
        && echo "syncthing: added device $name" || true
      syncthing cli config folders drop devices add --device-id "$sid" 2>/dev/null \
        && echo "syncthing: shared Drop with $name" || true
    fi
  done
  [ "$changed" = 1 ] && systemctl --user try-restart lan-mouse 2>/dev/null && echo "lan-mouse restarted"
  echo "pairing state applied"
}

viewer_ctl() {  # $1=side $2=start|stop — open/close the laptop's fullscreen viewer
  local ip; ip=$(jq -r --arg r "$1" '.machines[] | select(.role == $r) | .ip' "$CONFIG")
  [ -n "$ip" ] || return 0
  if ! curl -sf --max-time 3 -X POST -H 'Content-Type: application/json' \
      -d "{\"action\": \"$2\"}" "http://$ip:$CLIPSYNC_PORT/monitor" >/dev/null 2>&1; then
    if [ "$2" = start ]; then
      echo "note: couldn't reach the $1 laptop — launch 'Desktop Monitor' there by hand"
    else
      echo "note: couldn't reach the $1 laptop to close its viewer"
    fi
  fi
}

# One-shot health check for "something feels off": prints ok/FAIL per item
# and exits non-zero if anything needs attention.
doctor() {
  local rc=0
  ok()  { echo "  ok    $1"; }
  bad() { echo "  FAIL  $1"; rc=1; }
  echo "$my_name ($my_role) — $my_ip"

  echo "config:"
  if [ "$(jq '[.machines[] | select(.role == "desktop")] | length' "$CONFIG")" = 1 ]; then
    ok "machines.json has exactly one desktop"
  else
    bad "machines.json must have exactly one machine with role 'desktop'"
  fi

  echo "services:"
  local s
  for s in clipsync lan-mouse syncthing; do
    if systemctl --user is-active --quiet "$s" 2>/dev/null; then
      ok "$s running"
    else
      bad "$s not running — systemctl --user status $s"
    fi
  done
  [ -e "$PAUSE_FLAG" ] && echo "  note  clipboard sync is paused (multibox resume)"

  echo "lan-mouse:"
  local lm_list
  lm_list=$(lan-mouse cli list 2>/dev/null || true)
  # zero clients is the silent failure mode of the old config format:
  # daemon runs, logs are clean, mouse just never crosses an edge
  [ -n "$lm_list" ] || bad "no clients listed — mouse won't cross edges (re-run: multibox apply)"
  if awk '/^\[authorized_fingerprints\]/{f=1;next} /^\[/{f=0} f&&NF{n++} END{exit !n}' \
      "$LM_CONFIG" 2>/dev/null; then
    ok "peer fingerprints authorized"
  else
    bad "no authorized fingerprints — run 'multibox pair' on every machine"
  fi

  echo "peers:"
  local name ip role
  while IFS=$'\t' read -r name ip role; do
    if probe "$ip"; then
      ok "$name ($ip) answers"
    else
      bad "$name ($ip) unreachable — installed and on the tailnet?"
    fi
    if [ -n "$lm_list" ] && ! grep -qiF "$name" <<<"$lm_list"; then
      bad "$name missing from lan-mouse clients (re-run: multibox apply)"
    fi
  done < <(jq -r --arg ip "$my_ip" \
      '.machines[] | select(.ip != $ip) | [.name, .ip, .role] | @tsv' "$CONFIG")

  if [ "$my_role" = desktop ] \
      && { [ -f "$RUNTIME/extend-display/left" ] || [ -f "$RUNTIME/extend-display/right" ]; }; then
    echo "extend-display:"
    local side pid
    for side in left right; do
      [ -f "$RUNTIME/extend-display/$side" ] || continue
      pid=$(sed -n 2p "$RUNTIME/extend-display/$side")
      if kill -0 "$pid" 2>/dev/null; then
        ok "extend '$side' active (wayvnc pid $pid)"
      else
        bad "extend '$side' state is stale, wayvnc died — run: multibox extend stop $side"
      fi
    done
  fi

  if [ "$rc" = 0 ]; then echo "all good"; else echo "problems found"; fi
  return $rc
}

extend() {
  [ "$my_role" = desktop ] || die "extend is desktop-only"
  local ed="$HOME/.local/bin/extend-display"
  case "${1:-}" in
  start)
    [ -n "${2:-}" ] || die "usage: multibox extend start left|right"
    if [ -f "$RUNTIME/extend-display/$2" ]; then
      # already extended: don't fail, just make sure the laptop viewer is up
      # (covers the viewer having been closed on the laptop side)
      echo "'$2' is already extended — re-triggering the laptop viewer"
      viewer_ctl "$2" start
      return 0
    fi
    local mode input="" fps
    mode=$(jq -r --arg s "$2" '.options.extend[$s] // "1920x1080@60"' "$CONFIG")
    fps=$(jq -r '.options.extend.fps // 60' "$CONFIG")
    [ "$(jq -r '.options.extend.input // false' "$CONFIG")" = true ] && input="--with-input"
    "$ed" start "$2" "${3:-$mode}" $input "--fps=$fps"
    # config-level pause: a lan-mouse restart must not re-arm this edge
    gen_lm_config
    # the laptop switches itself into being the extra screen
    viewer_ctl "$2" start
    ;;
  stop)
    local sides="${2:-all}"
    [ "$sides" = all ] && sides="left right"
    local s
    for s in $sides; do
      "$ed" stop "$s"
      viewer_ctl "$s" stop
    done
    gen_lm_config
    ;;
  *)
    exec "$ed" "$@"
    ;;
  esac
}

case "$cmd" in
  status)       status "${2:-}" ;;
  setup)        exec python3 "$HOME/.local/bin/multibox-setup.py" ;;
  apply)        apply ;;
  pause)        touch "$PAUSE_FLAG"
                echo "clipboard sync paused — file drops, ~/Drop and extend keep working" ;;
  resume)       rm -f "$PAUSE_FLAG"
                # also recover from a pre-flag-era pause that stopped the service
                systemctl --user start clipsync 2>/dev/null || true
                echo "clipboard sync resumed" ;;
  doctor)       doctor ;;
  drop)         setsid -f python3 "$HOME/.local/bin/dropzone.py" >/dev/null 2>&1 ;;
  send)         shift; send "$@" ;;
  send-window)  shift; send_window "$@" ;;
  extend)       shift; extend "$@" ;;
  pair)         pair ;;
  pairing-info) pairing_info ;;
  *)            sed -n '2,/^set -e/ s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
